# Copy to .env.local (never commit .env.local). Values: Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / publishable key. It is safe in the browser ONLY because Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# DO NOT add the Supabase service_role key to this project. It bypasses RLS and must never
# reach frontend code or be committed.
